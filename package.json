{
  "name": "fullstacksjs-vscode",
  "displayName": "FullstacksJS Theme",
  "description": "FullstacksJS community Minimal VSCode and Cursor theme based on FlatRemix",
  "version": "1.7.0",
  "publisher": "FullstacksJS",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/fullstacksjs/vscode-theme.git"
  },
  "bugs": {
    "url": "https://github.com/fullstacksjs/vscode-theme/issues"
  },
  "homepage": "https://fullstacksjs.com",
  "icon": "assets/icon.png",
  "galleryBanner": {
    "color": "#23252e",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.139.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "dark",
    "flatremix",
    "fullstacksjs",
    "color-theme"
  ],
  "contributes": {
    "themes": [
      {
        "label": "FullstacksJS (Legacy)",
        "uiTheme": "vs-dark",
        "path": "./themes/legacy.json"
      },
      {
        "label": "FullstacksJS (Main)",
        "uiTheme": "vs-dark",
        "path": "themes/generated/main.json"
      },
      {
        "label": "FullstacksJS (Dark)",
        "uiTheme": "vs-dark",
        "path": "themes/generated/dark.json"
      },
      {
        "label": "FullstacksJS (Warm)",
        "uiTheme": "vs-dark",
        "path": "themes/generated/warm.json"
      }
    ]
  },
  "scripts": {
    "dev": "node --watch --watch-path src/ src/generate.ts",
    "verify": "eslint src/",
    "build": "node src/generate.ts && vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies"
  },
  "devDependencies": {
    "@fullstacksjs/eslint-config": "15.4.0",
    "@types/node": "24.19.2",
    "@types/vscode": "1.138.0",
    "@vscode/vsce": "4.1.0",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3"
  }
}
